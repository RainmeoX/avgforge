          "id": "e26fb799-69c8-41bf-a489-800b5d9e3585",
          "content": [
            {
              "type": "text",
              "text": "剩下的 15 天，我们形影不离。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "83b65db2-726f-4500-9d7b-46489f7392ed",
          "content": [
            {
              "type": "text",
              "text": "看日出、数星星、聊彼此的世界……",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "162e1ce1-fb3a-47dc-89ba-fe9a1ce3d6b8",
          "content": [
            {
              "type": "text",
              "text": "每一刻都珍贵得像是要碎掉。",
              "styles": {}
            }
          ]
        }
      ]
    },
