            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "cc666b4b-20ec-4288-9282-f988ccdab956",
          "content": [
            {
              "type": "text",
              "text": "别找了。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
