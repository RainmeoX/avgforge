          "content": [
            {
              "type": "text",
              "text": "我翻遍了图书馆的所有天文书籍。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "ad071e7f-cbd0-421e-9c78-0c23ffdcfd70",
          "content": [
            {
              "type": "text",
              "text": "询问了每一个可能知道的人。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "23e5cf3b-47d1-4d64-8d82-0672d79005db",
          "content": [
            {
              "type": "text",
              "text": "但答案都是一样的——",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "90cc3d38-94c9-47e8-a0c8-8d518779970a",
          "content": [
            {
              "type": "text",
              "text": "星轨的能量，无法在地球维持她的存在。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "8d3a1f54-3565-4e0f-af40-702e48295461",
