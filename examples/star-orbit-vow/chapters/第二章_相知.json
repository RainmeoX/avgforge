            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "f037a438-27ca-4fd2-b667-57e801d52dec",
          "content": [
            {
              "type": "text",
              "text": "再过 15 天，星轨就要离开了。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "8d3a1f54-3565-4e0f-af40-702e48295461",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "dc7e466b-b51b-40ff-ab9d-55521ceed8a7",
          "content": [
            {
              "type": "text",
              "text": "我必须搭上它，否则会永远消散。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "fc1722db-e6a0-48d7-9ea7-c73df919f941",
          "content": [
            {
              "type": "text",
              "text": "消散？",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "d636d7e5-5e03-4150-9796-b456b5f62498",
          "content": [
            {
              "type": "text",
              "text": "我握紧了拳头。",
              "styles": {}
            }
          ]
        },
        {
          "type": "branch",
          "props": {
