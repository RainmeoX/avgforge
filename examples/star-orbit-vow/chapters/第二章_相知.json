          "id": "dd37aa19-fb28-4a3f-b66b-014df5622b34",
          "content": [
            {
              "type": "text",
              "text": "星野带我来到了星轨观测站。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "141e3e00-5eb9-4be6-aea7-6276ac57ca70",
          "content": [
            {
              "type": "text",
              "text": "那是一个悬浮在山顶的银色平台。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "8d3a1f54-3565-4e0f-af40-702e48295461",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
