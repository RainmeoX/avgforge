            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「我送你。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "8b0b1e4a-d73b-4543-8e06-fa435ea1a6f4",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-me",
            "characterName": "我",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": false,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「约定改期。改成——北海道见。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "3a0a6e12-ac58-4a49-849a-8a2660aec286",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "一周后。梅雨回来了，站台上的伞连成一片深色的屋顶。",
              "styles": {}
            }
          ]
        },
