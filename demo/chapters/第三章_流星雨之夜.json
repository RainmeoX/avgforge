            {
              "type": "text",
              "text": "【真结局 · 星轨之约】十年后的今晚，请准时抬头。",
              "styles": {}
            }
          ]
        }
      ]
    },
    {
      "id": "1ee3bcdf-a270-4bca-a690-b3e95e1632fb",
      "name": "送行",
      "blocks": [
        {
          "id": "736abb08-4618-4969-ae89-9a4f9f60ea1e",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-me",
            "characterName": "我",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": false,
