            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "【普通结局 · 远方来信】此后每年流星雨，邮箱里都会有一张盖着札幌邮戳的明信片。",
              "styles": {}
            }
          ]
        }
      ]
    },
    {
      "id": "a9d87bca-f7fb-4a09-b151-c0eea9acd400",
      "name": "沉默",
      "blocks": [
        {
          "id": "2de0556b-e06d-4a63-a341-383fd15baa64",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "我把观测日志递了过去。",
              "styles": {}
            }
          ]
        },
        {
          "id": "0e284456-4fd9-449d-b817-07abe7600c2a",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "她接住。指尖碰到我的手背，停了一秒。",
              "styles": {}
            }
          ]
        },
        {
          "id": "f66d8dd2-049f-487a-b436-e740c212a0e8",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "平静",
            "position": "right",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「……这样啊。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "46235f62-8666-4dae-86f0-85a31b30de57",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "她低下头，一页，一页地翻。翻到最后一页的时候，流星雨正好到极大。",
              "styles": {}
            }
          ]
        },
        {
          "id": "c03ef923-7e5d-4a7e-8091-16334de0aa48",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "有多少颗流星落下来，就有多少句话沉回肚子里。三十天，27 页。我们写了星星，写了齿轮，写了天气——唯独没写对方。",
              "styles": {}
            }
          ]
        },
        {
          "id": "e3a7c092-ba3e-4998-8516-793444fea6f8",
          "type": "scene",
          "props": {
            "disabled": false,
            "sceneId": "scene-fin-bad",
            "sceneName": "Bad_End",
            "uri": "",
            "autoAddToGallery": "true",
            "galleryMethodTarget": "avg.internal.default-shell/add-to-gallery",
