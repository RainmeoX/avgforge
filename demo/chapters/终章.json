          },
          "id": "e9ddbd2b-98b2-42a2-bb00-47883bdf4172"
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "ef4ba4fe-8dda-4cce-bd32-4c8e36ce6aec",
          "content": [
            {
              "type": "text",
              "text": "我看着她踏上星轨。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "08963072-851d-4865-9764-8ea3c8151280",
          "content": [
            {
              "type": "text",
              "text": "再见。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "a12eb47f-d46f-4349-803b-6ce9c56c77e6",
          "content": [
            {
              "type": "text",
              "text": "下一个 120 年，我还会来的。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "9c4f16bf-caec-459d-a236-36ce09fff840",
          "content": [
            {
              "type": "text",
              "text": "她化作一道光，消失在星空中。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "e157aa52-4fb9-4f8c-a316-bd1cd9074d87",
          "content": [
            {
              "type": "text",
              "text": "我站在天台上，看着那颗最亮的星。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "31a4d0b4-9486-4c91-b73b-cddecdd90b6e",
          "content": [
            {
              "type": "text",
              "text": "120 年……",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "d82258bc-583a-484b-af65-20741041d0d7",
          "content": [
            {
              "type": "text",
              "text": "那是我无法到达的远方。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "a4674568-6a2a-4808-a43e-c20b96a35a4f",
          "content": [
            {
              "type": "text",
              "text": "但我知道，她还在那里。",
              "styles": {}
            }
          ]
        }
      ]
    },
    {
