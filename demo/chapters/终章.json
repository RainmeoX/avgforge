        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "a75aee59-9bd1-45b2-a338-beabf575fa5d",
          "content": [
            {
              "type": "text",
              "text": "我握住了她的手。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-me",
            "characterName": "我",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "28b08933-688d-4c5b-b51b-c1de29d7224e",
          "content": [
            {
              "type": "text",
              "text": "我跟你走。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "64214b10-c42d-47e4-ad1a-cc9f18e1e3b1",
          "content": [
            {
              "type": "text",
              "text": "你……你确定吗？",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "c8f159dd-9a80-4c24-9245-bc5038156d15",
          "content": [
            {
              "type": "text",
              "text": "我点了点头。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "d33b084a-5a7d-4468-bdec-fc6997ffcda5",
          "content": [
            {
              "type": "text",
              "text": "星轨的光芒笼罩了我们。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "53e1b860-f096-4031-b42f-5ece77dfe2a6",
          "content": [
            {
              "type": "text",
              "text": "地球在我脚下越来越小。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "980b9e7e-a43a-42b6-9abb-733f5736041f",
          "content": [
            {
              "type": "text",
              "text": "但我的手，始终握着她的。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "8f6f1688-6ba4-4d3b-9814-e12400c9f3bc",
          "content": [
            {
              "type": "text",
              "text": "——星轨之约，永不分离。——",
              "styles": {}
            }
          ]
        }
      ]
    },
    {
      "id": "a54965c0-7392-4157-b22b-d1a7abf504cc",
      "name": "普通结局",
      "blocks": [
        {
          "type": "scene",
          "props": {
            "disabled": false,
            "sceneId": "scene-ending-normal",
            "sceneName": "普通结局",
            "uri": "",
