        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "50f5eb95-d14d-4c36-8be0-33921a76c3de",
          "content": [
            {
              "type": "text",
              "text": "留下来？",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "8eb5912a-0ecc-4a01-b108-fdf611f78764",
          "content": [
            {
              "type": "text",
              "text": "……我做不到。",
              "styles": {}
            }
          ]
        },
        {
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "f40daf33-50f6-467d-8ce4-09c517f2e13f",
          "content": [
            {
              "type": "text",
              "text": "如果留下来，我会在 24 小时内消散。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "e763a3fe-5983-42e6-a33d-22bb3af313f0",
          "content": [
            {
              "type": "text",
              "text": "但她没有听我的话。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "52542bb1-6f4b-44d5-bc9a-1889fbffd605",
          "content": [
            {
              "type": "text",
              "text": "零点的钟声响起时，她化作漫天的光点。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "3311e829-5380-41ac-b726-a38f5029e12f",
          "content": [
            {
              "type": "text",
              "text": "其中一颗，特别亮，特别近。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "93fe5ea4-580a-4d64-9173-e7f7d55a4a46",
          "content": [
            {
              "type": "text",
              "text": "它停在了天台的正上方，再也没有移动过。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "9c390205-5f56-441b-ba69-184cebf86456",
          "content": [
            {
              "type": "text",
              "text": "后来，我毕业、工作、老去。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "69e8c722-e769-4feb-98ac-8dd7117955a9",
          "content": [
            {
              "type": "text",
              "text": "每个失眠的夜晚，我都会去天台。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "bfc053fc-3038-45cc-a261-045c9428ecd7",
          "content": [
            {
              "type": "text",
              "text": "抬头，看着那颗星。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "5b10e534-5d00-4731-a829-1db0d0a2975e",
          "content": [
            {
              "type": "text",
              "text": "我知道，那是她。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "be6b8b0b-241e-44fb-96f3-59d6ddd9c13b",
          "content": [
            {
              "type": "text",
              "text": "她还在那里。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "2284134d-248b-40cc-9d81-68c98f910339",
          "content": [
            {
              "type": "text",
              "text": "只是，再也不会回答我了。",
              "styles": {}
            }
          ]
        }
      ]
    }
  ]
}