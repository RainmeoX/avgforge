          }
        },
        {
          "id": "f78cada9-ee88-41f7-984d-a03d2902280e",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "第三十天倒计时三天。布告栏上的「限期交还」换成了红色的一张——第三张了。",
              "styles": {}
            }
          ]
        },
        {
          "id": "dc61dff5-2720-4cc8-92f5-735c124af948",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-ritu",
            "characterName": "柏木律",
            "expression": "平静",
            "position": "center",
            "isFirst": false,
            "isLast": false,
            "showCharacter": false,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「成果提交窗口，还剩七十二小时。逾期，视同放弃。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "ce2161a2-1420-479c-b7c1-daf16e0e9cde",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "夕阳里，两个「顺便」找上我。",
              "styles": {}
            }
          ]
        },
        {
          "id": "acfcf533-f068-48ff-8dd1-b44308d62318",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-aoi",
            "characterName": "日向葵",
            "expression": "开心",
            "position": "center",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「文化祭特番缺搭档！就你！会念稿的那种！」",
              "styles": {}
            }
          ]
        },
        {
          "id": "0915c27b-2b1f-413b-ad8f-ec1f65ffc964",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-mizuki",
            "characterName": "深月",
            "expression": "平静",
            "position": "center",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「……档案室。1994 年的。要整理。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "db2e8cbe-9480-4460-8906-9deadca5137d",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
