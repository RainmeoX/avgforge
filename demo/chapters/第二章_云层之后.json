{
  "id": "c0379083-4d73-4323-af8d-afa8058df2ee",
  "name": "第二章_云层之后",
  "fragments": [
    {
      "id": "81a65596-8370-4e37-b5d5-79725c386721",
      "name": "main",
      "blocks": [
        {
          "id": "7e91a86b-1fae-4057-b20f-f63ea2d2855f",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "入梅。天空像被人拉上了一层永远洗不干净的灰窗帘。",
              "styles": {}
            }
          ]
        },
        {
          "id": "e2885f38-90cb-4707-abca-15b175d53274",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "连续十四天，一颗星都看不见。观测日志，停在第二十一页。",
              "styles": {}
            }
          ]
        },
        {
          "id": "875ba636-e482-4b53-b298-cf7364a8fa3e",
          "type": "scene",
          "props": {
            "disabled": false,
            "sceneId": "scene-cafe",
