            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "第二天早上，她在校门口等我，书包上挂了个自制的「天文部部员二号」铭牌。",
              "styles": {}
            }
          ]
        },
        {
          "id": "08c73f12-25ef-4a1f-963f-6b31c15c21b3",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "三十天，说长不长。她的「报到」变成每天放学雷打不动的动静。",
              "styles": {}
            }
          ]
        },
        {
          "id": "fedd6a0b-667f-477f-8209-54404091c48a",
          "type": "scene",
          "props": {
            "disabled": false,
            "sceneId": "scene-hallway",
            "sceneName": "走廊",
            "uri": "",
            "autoAddToGallery": "true",
            "galleryMethodTarget": "avg.internal.default-shell/add-to-gallery",
            "transitionMode": "fade",
