        {
          "id": "c33caeb0-d9f4-4aa9-89cf-a4d1786dff67",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "第十个傍晚，新配的电机在河堤上试转。晚风把她的观测日志吹得哗哗响。",
              "styles": {}
            }
          ]
        },
        {
          "id": "ab3afd4f-fcf3-43c0-884f-57a64599ed6d",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "平静",
            "position": "right",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「你有没有想过，十年后的自己，会在哪里？」",
              "styles": {}
            }
          ]
        },
        {
          "id": "c9b3eb60-a2d9-4ec2-9b6e-f75750e2ba72",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-me",
            "characterName": "我",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": false,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「……先把这三十天过完再说。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "1ffc4225-7948-4775-8964-2c501819531e",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "开心",
            "position": "right",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「真没出息～」她笑得很大声，然后自己望着河面，发了很久很久的呆。",
              "styles": {}
            }
          ]
        },
        {
          "id": "880b63e0-9442-4ea1-982e-4d7ea393b734",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "夕阳把河水烧成一条金线。我第一次觉得，三十天这个期限，有点短。",
              "styles": {}
            }
          ]
        },
        {
          "id": "c55c1c1b-68df-42be-b144-76e1933ceefc",
          "type": "branch",
          "props": {
            "disabled": false,
            "branchId": "346de2a4-1bd0-401a-9d36-5ad7b60772ba",
            "title": "午休分岔（回溯）",
            "choices": "[{\"mode\": \"jump\", \"text\": \"（回忆）去商店街那天\", \"fragmentId\": \"dc79d5e2-082b-4956-859d-114b3132715d\"}, {\"mode\": \"jump\", \"text\": \"（回忆）去图书馆那天\", \"fragmentId\": \"e9ec15a0-1834-42e9-b2a5-713ae94fad97\"}]"
          }
        }
      ]
    },
