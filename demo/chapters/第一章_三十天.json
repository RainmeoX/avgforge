            "bLit": "1",
            "bVar": "",
            "binOp": ""
          },
          "id": "666ec4bf-383a-4e35-963b-3ee15a574121"
        },
        {
          "id": "1ad381f6-dd88-4c0c-8c8f-280320ae578c",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "弹珠在瓶底叮当响。我把汽水喝完，把弹珠揣进了校服口袋。",
              "styles": {}
            }
          ]
        }
      ]
    },
