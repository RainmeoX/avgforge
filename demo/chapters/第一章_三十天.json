        {
          "id": "d868dfaf-1a3e-4b6c-bef0-8fc32b323fb4",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "电料行的老板翻遍了半个仓库，才从一堆旧收音机里扒出一颗能用的齿轮。",
              "styles": {}
            }
          ]
        },
        {
          "id": "24c69316-be7c-4f49-b39d-8b9a5964b3bd",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-me",
            "characterName": "我",
            "expression": "",
            "position": "",
            "isFirst": false,
            "isLast": false,
            "showCharacter": false,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「就这个。多少钱？」",
              "styles": {}
            }
          ]
        },
        {
          "id": "6ea16352-220f-462b-aa71-6ad8e50d6bb6",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "开心",
            "position": "right",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「老板说我们像来踢馆的。」",
              "styles": {}
            }
          ]
        },
        {
          "id": "91fe6a9d-12f2-41ad-9e9c-ba26370f4cbf",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
            "voiceBlipWaveform": "triangle",
            "voiceBlipBaseFrequencyHz": 340,
            "voiceBlipPitchRangeSemitones": 2.4,
            "voiceBlipDurationMs": 48,
            "voiceBlipVolume": 55,
            "voiceBlipMinIntervalMs": 42
          },
          "content": [
            {
              "type": "text",
              "text": "回去的电车上，她用校服袖子垫着那颗齿轮，捧了一路，像捧着一颗会转的心脏。",
              "styles": {}
            }
          ]
        },
        {
          "id": "46e6d2e6-ac5f-4481-ba96-d838ff3bfecf",
          "type": "dialogue",
          "props": {
            "disabled": false,
            "characterId": "char-hoshino",
            "characterName": "星野",
            "expression": "害羞",
            "position": "right",
            "isFirst": false,
            "isLast": false,
            "showCharacter": true,
            "keepCharacter": true,
            "keepDialogue": true,
            "voiceHash": "e4fbba57c192831252e165b47322dd3d"
          },
          "content": [
            {
              "type": "text",
              "text": "「谢礼！」收工时她塞给我一瓶弹珠汽水，「喝完弹珠要还我。这，也算约定。」",
              "styles": {}
            }
          ]
        },
        {
          "type": "setver",
          "props": {
            "disabled": false,
            "key": "trust",
            "op": "add",
            "aKind": "variable",
            "aLit": "",
            "aVar": "trust",
