        {
          "id": "5bb82b33-1a9a-4367-9d85-a365b16a1647",
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": "",
            "voiceBlip": false,
            "voiceBlipPreset": "",
