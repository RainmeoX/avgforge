          "content": [
            {
              "type": "text",
              "text": "她的眼睛亮了起来，像两颗小星星。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
