          "id": "7250fedc-5786-4090-92df-36ee3ec75d81",
          "content": [
            {
              "type": "text",
              "text": "从那天起，我开始带她游览这个小镇。",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "1503751f-c72c-4e81-bbff-71d0c757c34e",
          "content": [
            {
              "type": "text",
              "text": "图书馆、咖啡馆、公园……",
              "styles": {}
            }
          ]
        },
        {
          "type": "narration",
          "props": {
            "disabled": false,
            "keepDialogue": true,
            "voiceHash": ""
          },
          "id": "6ab46da5-784d-42dd-b0e1-6522fb08a3bd",
          "content": [
            {
              "type": "text",
              "text": "每一个地方，她都看得津津有味。",
              "styles": {}
            }
          ]
        }
      ]
