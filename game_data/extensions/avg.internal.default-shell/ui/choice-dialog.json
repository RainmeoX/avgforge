      "style": {
        "fontSize": 26,
        "fontWeight": 500,
        "letterSpacing": 0.4,
        "color": "#e8f1f0",
        "fill": "transparent",
        "borderColor": "rgba(127, 212, 200, 0.36)",
        "borderWidth": 1,
        "radius": 14,
        "opacity": 100,
        "customCss": "font-family: \"Plus Jakarta Sans\", \"M PLUS Rounded 1c\", \"PingFang SC\", \"Hiragino Sans GB\", \"HarmonyOS Sans\", \"Microsoft YaHei\", -apple-system, BlinkMacSystemFont, sans-serif;"
      },
      "animation": {
